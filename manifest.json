{
  "manifest_version": 3,
  "name": "eTab - Tab Manager",
  "version": "0.1.0",
  "description": "A powerful tab management extension",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "eTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "chrome_url_overrides": {
    "newtab": "src/tabs/index.html"
  },
  "commands": {
    "open-tabs-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "打开 eTab 标签管理器"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
